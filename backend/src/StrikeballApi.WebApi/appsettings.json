{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "__DB_CONNECTION_STRING__",
    "Redis": "__REDIS_CONNECTION_STRING__"
  },
  "JwtSettings": {
    "SecretKey": "__JWT_SECRET_KEY__",
    "Issuer": "StrikeballApi",
    "Audience": "StrikeballClient",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "FileStorage": {
    "BasePath": "files",
    "MaxFileSize": 5242880,
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".pdf" ]
  }
}
